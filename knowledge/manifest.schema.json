{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://debugmate.local/schemas/knowledge-source-manifest-v1.json",
  "title": "DebugMate Knowledge Source Manifest",
  "type": "array",
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "title",
      "url",
      "product",
      "version_scope",
      "platform",
      "retrieved_at",
      "sha256",
      "license_or_terms_note"
    ],
    "properties": {
      "source_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      },
      "title": {"type": "string", "minLength": 1},
      "url": {"type": "string", "format": "uri", "pattern": "^https://"},
      "product": {
        "enum": [
          "python",
          "pip",
          "pytorch",
          "cuda",
          "huggingface",
          "ultralytics",
          "windows"
        ]
      },
      "version_scope": {"type": "string", "minLength": 1},
      "platform": {"type": "string", "minLength": 1},
      "allowed_domain": {"type": "string", "minLength": 1},
      "heading_patterns": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "minLength": 1}
      },
      "error_categories": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "dependency_environment",
            "path_permission",
            "python_runtime",
            "tensor_shape_dtype",
            "cuda_memory",
            "model_loading",
            "unknown"
          ]
        }
      },
      "retrieved_at": {"type": "string", "format": "date-time"},
      "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "license_or_terms_note": {"type": "string", "minLength": 1},
      "selection_reason": {"type": "string", "minLength": 1}
    }
  }
}
